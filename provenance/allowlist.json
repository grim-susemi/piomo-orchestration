{
  "schema": "piomo.publish-allowlist/1",
  "repository": "piomo-orchestration",
  "displayName": "PiOMO Orchestration Mod",
  "visibility": "private",
  "description": "Source-only publish boundary for the curated private repository. Evaluation order: (1) an exact allowedPaths entry always allows a path; (2) otherwise a deniedPatterns match prohibits it; (3) otherwise an allowedPatterns glob allows it; (4) otherwise the path is prohibited by default. Every file, allowed or not, is additionally inspected for secret tokens by qa/audit-publish.mjs. Rights: UNLICENSED owner-authored files, except the four MIT-licensed senpi prompt-preset resolver regex lines recorded in provenance/components.json with the verbatim upstream notice carried in full at licenses/senpi-MIT.txt; unknown-rights third-party code is excluded. No generated OMO bundles, downloaded upstream trees, archives, raw machine settings/auth/models/trust, pr-watch snapshots, logs, cache, session, memory, rollback or retired guard/compaction files may be published.",
  "allowedPaths": [
    "provenance/allowlist.json",
    "licenses/senpi-MIT.txt",
    "provenance/components.json",
    "provenance/license-scope.json",
    "provenance/installed-state.json",
    "qa/audit-publish.mjs",
    "qa/audit-components.mjs",
    "qa/audit-packages.mjs",
    "qa/rebuild.mjs",
    "scripts/pr-watch.mjs",
    "README.md",
    "extensions/omo-model-tuning.ts",
    "extensions/omo-model-tuning.test.js",
    ".gitattributes",
    "examples/settings.json",
    "packages/README.md",
    "packages/local-intent-clarifier-hook/README.md",
    "packages/local-intent-clarifier-hook/extensions/intent-clarifier-hook.ts",
    "packages/local-intent-clarifier-hook/extensions/lib/custom-mode-policy.ts",
    "packages/local-omo-subagent-skill-correction/README.md",
    "packages/local-omo-subagent-skill-correction/compatibility.json",
    "packages/local-omo-subagent-skill-correction/extensions/omo-subagent-skill-correction.ts",
    "packages/local-omo-subagent-skill-correction/extensions/omo-subagent-skill-correction.mjs",
    "packages/local-omo-subagent-skill-correction/extensions/omo-subagent-skill-correction.d.mts",
    "packages/piomo-judgment-workflow/README.md",
    "packages/piomo-judgment-workflow/extensions/judgment-contract.ts",
    "packages/piomo-judgment-workflow/extensions/judgment-recipe.ts",
    "packages/piomo-judgment-workflow/extensions/judgment-routing.ts",
    "packages/piomo-judgment-workflow/extensions/skill-workflow.ts",
    "packages/piomo-judgment-workflow/extensions/workflow-composition.ts",
    "packages/piomo-personal-core/README.md",
    "packages/piomo-personal-core/compatibility.json",
    "packages/piomo-personal-skills/README.md",
    "packages/piomo-personal-skills/duplicates.json",
    "provenance/source-adaptations.json",
    "scripts/pr-watch.prune.test.mjs"
  ],
  "allowedPatterns": [
    "patches/beta88/deltas/*.insert.js",
    "patches/beta88/anchors/*.mjs",
    "patches/beta88/qa/*.test.mjs",
    "qa/*.test.mjs",
    "packages/*/package.json",
    "packages/piomo-personal-skills/skills.json",
    "packages/piomo-personal-skills/skills/**",
    "packages/*/src/**",
    "packages/*/test/**",
    "docs/*.md"
  ],
  "deniedPatterns": [
    "**/*.tgz",
    "**/*.tar",
    "**/*.tar.gz",
    "**/*.zip",
    "**/*.patch",
    "**/*.diff",
    "**/upstream/**",
    "**/downloads/**",
    "**/settings.json",
    "**/settings.jsonc",
    "**/auth.json",
    "**/credentials.json",
    "**/models.json",
    "**/trust.json",
    "**/trustdb.json",
    "**/.env",
    "**/.env.*",
    "**/*.log",
    "**/snapshots/**",
    "**/snapshot/**",
    "**/cache/**",
    "**/logs/**",
    "**/sessions/**",
    "**/memory/**",
    "**/rollback/**",
    "**/backups/**",
    "**/target/**",
    "**/dist/**",
    "**/build/**",
    "**/node_modules/**",
    "**/omo-ai/**",
    "**/plugin/**",
    "**/*.bundle.js",
    "**/compaction/**",
    "**/guard/**",
    "**/*.tmp"
  ],
  "deniedClasses": [
    "generated-omo-bundle",
    "downloaded-upstream-tree",
    "archive-tarball",
    "raw-settings",
    "raw-auth",
    "raw-models",
    "raw-trust",
    "pr-watch-snapshot",
    "log-cache-session",
    "memory-rollback",
    "retired-guard-compaction",
    "unknown-rights-third-party"
  ]
}